---
import { FiSun, FiMoon } from "react-icons/fi";
import { FaArrowLeft } from "react-icons/fa6";
import { useTranslations, localizePath, type Lang } from "../i18n/ui";

interface Props {
  lang: Lang;
  /** Resolved URL of this page in each language. */
  paths: Record<Lang, string>;
  isHome: boolean;
}

const { lang, paths, isHome } = Astro.props;
const t = useTranslations(lang);

const control =
  "inline-flex items-center justify-center rounded-lg border border-surface-border/60 " +
  "text-content-secondary transition-colors duration-150 focus-ring " +
  "hover:text-content-primary";
---

<div
  class="sticky top-0 z-30 w-full backdrop-blur-md bg-page/80 border-b border-surface-border/30"
>
  <nav
    aria-label={t("nav.home")}
    class="mx-auto flex w-full max-w-6xl items-center justify-between gap-3 px-4 py-2 sm:px-6"
  >
    {
      isHome ? (
        <span class="text-sm font-semibold text-content-primary">
          battaglino<span class="text-content-accent">.dev</span>
        </span>
      ) : (
        <a
          href={localizePath("/", lang)}
          class={`${control} h-11 gap-2 px-3 text-sm font-medium`}
        >
          <FaArrowLeft aria-hidden="true" />
          {t("nav.back")}
        </a>
      )
    }

    <div class="flex items-center gap-2">
      <!-- Language: real links, so Cmd-click and "open in new tab" keep working. -->
      <ul
        class="flex items-center overflow-hidden rounded-lg border border-surface-border/60"
        aria-label={t("controls.language")}
      >
        <li>
          <a
            href={paths.en}
            hreflang="en"
            lang="en"
            aria-current={lang === "en" ? "true" : undefined}
            class={`flex h-11 min-w-11 items-center justify-center px-2 text-xs font-semibold transition-colors duration-150 focus-ring-inset ${
              lang === "en"
                ? "bg-content-accent/15 text-content-accent"
                : "text-content-secondary hover:text-content-primary"
            }`}
          >
            EN
          </a>
        </li>
        <li>
          <a
            href={paths.es}
            hreflang="es"
            lang="es"
            aria-current={lang === "es" ? "true" : undefined}
            class={`flex h-11 min-w-11 items-center justify-center px-2 text-xs font-semibold transition-colors duration-150 focus-ring-inset ${
              lang === "es"
                ? "bg-content-accent/15 text-content-accent"
                : "text-content-secondary hover:text-content-primary"
            }`}
          >
            ES
          </a>
        </li>
      </ul>

      <button
        type="button"
        data-theme-toggle
        data-label-dark={t("controls.theme.toDark")}
        data-label-light={t("controls.theme.toLight")}
        aria-label={t("controls.theme.toDark")}
        class={`${control} size-11 active:scale-[0.96] [transition-property:color,scale] motion-reduce:active:scale-100`}
      >
        <FiSun aria-hidden="true" className="hidden size-[18px] dark:block" />
        <FiMoon aria-hidden="true" className="size-[18px] dark:hidden" />
      </button>
    </div>
  </nav>
</div>
