---
import { Image } from "astro:assets";
import { FaLinkedin, FaGithub } from "react-icons/fa6";
import { IoMdDocument } from "react-icons/io";
import { useTranslations, type Lang } from "../i18n/ui";
import { BUTTON, FOCUS } from "../styles/ui";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

const links = [
  {
    href: lang === "es" ? "/cv/renzo-battaglino-cv-es.pdf" : "/cv/renzo-battaglino-cv.pdf",
    label: t("home.cv"),
    Icon: IoMdDocument,
    external: false,
  },
  { href: "https://linkedin.com/in/renzobxt", label: "LinkedIn", Icon: FaLinkedin, external: true },
  { href: "https://github.com/Naghell", label: "GitHub", Icon: FaGithub, external: true },
];
---

<section class="flex h-full flex-col justify-between gap-6">
  <div>
    <h1 class="text-pretty text-2xl font-bold leading-tight text-content-primary sm:text-3xl">
      {t("home.heading")}
    </h1>
    <p class="mt-1 text-lg font-semibold text-content-accent">{t("site.tagline")}</p>
    <p class="mt-3 max-w-[38ch] text-pretty leading-relaxed text-content-secondary">
      {t("home.blurb")}
    </p>
  </div>

  <div class="flex flex-wrap items-end justify-between gap-4">
    <Image
      src="/profile/picture.avif"
      alt="Renzo Luis Battaglino"
      height={176}
      width={176}
      loading="eager"
      class="size-28 shrink-0 self-end object-contain sm:size-36"
    />
    <ul class="flex min-w-[9rem] flex-1 flex-col gap-2">
      {
        links.map(({ href, label, Icon, external }) => (
          <li>
            <a
              href={href}
              target="_blank"
              rel={external ? "noopener noreferrer" : undefined}
              class={`${BUTTON} ${FOCUS} w-full justify-center`}
            >
              <Icon aria-hidden="true" />
              {label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>
