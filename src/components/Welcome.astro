---
import { Image } from "astro:assets";
import { FaLinkedin, FaGithub, FaXTwitter } from "react-icons/fa6";
import { IoMdDocument, IoMdMail } from "react-icons/io";
import { EMAIL, useTranslations, type Lang } from "../i18n/ui";
import { BUTTON, FOCUS } from "../styles/ui";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

const actions = [
  {
    href: lang === "es" ? "/cv/renzo-battaglino-cv-es.pdf" : "/cv/renzo-battaglino-cv.pdf",
    label: t("home.cv"),
    Icon: IoMdDocument,
  },
  { href: `mailto:${EMAIL}`, label: t("home.email"), Icon: IoMdMail },
];
// Icon-only: the names live in aria-label and the tooltip.
const social = [
  { href: "https://linkedin.com/in/renzobxt", label: "LinkedIn", Icon: FaLinkedin, external: true },
  { href: "https://github.com/Naghell", label: "GitHub", Icon: FaGithub, external: true },
  { href: "https://x.com/ren_tsx", label: "X", Icon: FaXTwitter, external: true },
];
---

<section class="flex h-full flex-col justify-between gap-8">
  <div>
    <h1 class="text-balance text-4xl font-bold leading-[1.05] tracking-tight text-content-primary sm:text-5xl">
      {t("home.heading")}
    </h1>
    <p class="mt-3 text-lg font-semibold text-content-accent">{t("site.tagline")}</p>
    <p class="mt-3 max-w-[38ch] text-pretty leading-relaxed text-content-secondary">
      {t("home.blurb")}
    </p>
  </div>

  <div class="flex items-end gap-4">
    <Image
      src="/profile/picture.avif"
      alt="Renzo Luis Battaglino"
      height={176}
      width={176}
      loading="eager"
      class="size-28 shrink-0 object-contain sm:size-36"
    />
    <div class="flex min-w-0 flex-1 flex-col gap-2">
      {
        actions.map(({ href, label, Icon }) => (
          <a href={href} target={href.startsWith("/") ? "_blank" : undefined} class={`${BUTTON} ${FOCUS} w-full justify-center`}>
            <Icon aria-hidden="true" />
            {label}
          </a>
        ))
      }
      <ul class="grid grid-cols-3 gap-2">
        {
          social.map(({ href, label, Icon }) => (
            <li>
              <a
                href={href}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={label}
                title={label}
                class={`${BUTTON} ${FOCUS} w-full justify-center`}
              >
                <Icon aria-hidden="true" className="size-[18px]" />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
