---
import Layout from "../../layouts/Layout.astro";
import PageHeader from "../../components/PageHeader.astro";
import { langPaths } from "../../i18n/paths";
import { toLang, useTranslations } from "../../i18n/ui";
import { workExperience } from "../../utils/experience";
import { CARD, CARD_TITLE, CHIP, FOCUS } from "../../styles/ui";

export const getStaticPaths = langPaths;

const lang = toLang(Astro.params.lang);
const t = useTranslations(lang);
const jobs = workExperience(lang);
---

<Layout lang={lang} path="/experience">
  <main id="main" class="mx-auto w-full max-w-6xl px-4 py-8 sm:px-6 sm:py-12">
    <PageHeader title={t("nav.experience")} />

    <ol class="flex flex-col gap-4">
      {
        jobs.map((job) => (
          <li>
            <article class="grid grid-cols-1 gap-4 lg:grid-cols-3">
              <header class={`${CARD} flex flex-col gap-4 lg:order-last`}>
                <div class="flex items-center gap-3">
                  {/* A neutral plate keeps mixed-brand logos legible in both themes,
                      instead of shipping a light and a dark variant of each. */}
                  <span class="flex size-12 shrink-0 items-center justify-center rounded-lg bg-plate p-2">
                    <img
                      src={job.logo}
                      alt={t("experience.logoAlt", { company: job.company })}
                      width="32"
                      height="32"
                      loading="lazy"
                      decoding="async"
                      class="size-8 object-contain"
                    />
                  </span>
                  <div class="min-w-0">
                    <h2 class={CARD_TITLE}>{job.company}</h2>
                    <p class="text-sm tabular-nums text-content-secondary">{job.period}</p>
                  </div>
                </div>
                <p class="font-medium text-content-primary">{job.position}</p>
                <p class="text-pretty leading-relaxed text-content-secondary">{job.description}</p>
                {job.companyUrl && (
                  <a
                    href={job.companyUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class={`${FOCUS} mt-auto inline-block self-start rounded-sm py-1 text-sm font-medium text-content-accent underline decoration-from-font underline-offset-4 hover:decoration-2`}
                  >
                    {job.companyUrl.replace("https://", "")}
                  </a>
                )}
              </header>

              <div class={`${CARD} lg:col-span-2 lg:row-span-2`}>
                <h3 class="mb-3 font-semibold text-content-primary">{t("experience.responsibilities")}</h3>
                <ul class="list-disc space-y-2 pl-5 text-content-secondary marker:text-content-accent">
                  {job.responsibilities.map((r) => (
                    <li class="max-w-[68ch] text-pretty leading-relaxed">{r}</li>
                  ))}
                </ul>
              </div>

              <section class={`${CARD} lg:order-last`}>
                <h3 class="mb-3 font-semibold text-content-primary">{t("experience.technologies")}</h3>
                <ul class="flex flex-wrap gap-2">
                  {job.technologies.map((tech) => (
                    <li class={CHIP}>
                      <tech.icon aria-hidden="true" className="size-4 shrink-0" />
                      <span class="whitespace-nowrap">{tech.name}</span>
                    </li>
                  ))}
                </ul>
              </section>
            </article>
          </li>
        ))
      }
    </ol>
  </main>
</Layout>
