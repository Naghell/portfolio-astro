---
import Layout from "../../layouts/Layout.astro";
import PageHeader from "../../components/PageHeader.astro";
import { langPaths } from "../../i18n/paths";
import { toLang, useTranslations } from "../../i18n/ui";
import { aboutData } from "../../utils/about";
import { CARD, CARD_TITLE } from "../../styles/ui";

export const getStaticPaths = langPaths;

const lang = toLang(Astro.params.lang);
const t = useTranslations(lang);
const about = aboutData(lang);

const facts = [
  { label: t("about.name"), value: about.personalInfo.name },
  { label: t("about.location"), value: about.personalInfo.location },
  { label: t("about.occupation"), value: about.personalInfo.occupation },
  { label: t("about.education"), value: about.personalInfo.education },
  { label: t("about.languages"), value: about.personalInfo.languages },
];
---

<Layout lang={lang} path="/about">
  <main id="main" class="mx-auto w-full max-w-6xl px-4 py-8 sm:px-6 sm:py-12">
    <PageHeader title={t("nav.about")} />

    <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
      <div class="grid gap-4">
        <section class={CARD}>
          <h2 class={`${CARD_TITLE} mb-3`}>{t("about.personal")}</h2>
          <dl class="space-y-2 text-content-secondary">
            {
              facts.map(({ label, value }) => (
                <div class="flex flex-col gap-0.5 sm:flex-row sm:gap-2">
                  <dt class="shrink-0 font-semibold text-content-primary">{label}:</dt>
                  <dd class="text-pretty leading-relaxed">{value}</dd>
                </div>
              ))
            }
          </dl>
        </section>
        <section class={CARD}>
          <h2 class={`${CARD_TITLE} mb-3`}>{t("about.summary")}</h2>
          <p class="max-w-[65ch] text-pretty leading-relaxed text-content-secondary">
            {about.professionalSummary}
          </p>
        </section>
      </div>
      <section class={CARD}>
        <h2 class={`${CARD_TITLE} mb-3`}>{t("about.journey")}</h2>
        <p class="max-w-[65ch] text-pretty leading-relaxed text-content-secondary">
          {about.journey}
        </p>
      </section>
      <section class={`${CARD} md:col-span-2`}>
        <h2 class={`${CARD_TITLE} mb-3`}>{t("about.interests")}</h2>
        <ul class="grid grid-cols-2 gap-3 text-content-secondary sm:grid-cols-4">
          {
            about.interests.map((interest) => (
              <li class="flex items-center gap-2">
                <interest.icon aria-hidden="true" className="size-5 shrink-0 text-content-accent" />
                <span class="text-pretty">{interest.name}</span>
              </li>
            ))
          }
        </ul>
      </section>
    </div>
  </main>
</Layout>
