---
import { Image } from "astro:assets";
import Layout from "../../layouts/Layout.astro";
import Welcome from "../../components/Welcome.astro";
import { langPaths } from "../../i18n/paths";
import { EMAIL, toLang, useTranslations, localizePath } from "../../i18n/ui";
import { postsFor } from "../../i18n/posts";
import { workExperience } from "../../utils/experience";
import { projects } from "../../utils/projects";
import { techStack } from "../../utils/stack";
import { aboutData } from "../../utils/about";
import { FaArrowUpRightFromSquare } from "react-icons/fa6";
import { BUTTON, CARD, CARD_HOVER, CARD_TITLE, CHIP, FOCUS } from "../../styles/ui";

export const getStaticPaths = langPaths;

const lang = toLang(Astro.params.lang);
const t = useTranslations(lang);

const all = projects(lang);
const habita = all[0];
// The two products people actually use, linked from the tile.
const live = all.filter((p) => ["Habita", "Barrito"].includes(p.title) && p.liveUrl);
const { personalInfo } = aboutData(lang);
const jobs = workExperience(lang);
const [latest] = await postsFor(lang);
// ponytail: the headline stack, picked by name from the full list on /tech-stack.
const MAIN = ["TypeScript", "React", "Next.js", "Node.js", "NestJS", "Go", "PostgreSQL", "Docker"];
const stack = techStack(lang)
  .flatMap((g) => g.items)
  .filter((i) => MAIN.includes(i.name))
  .sort((a, b) => MAIN.indexOf(a.name) - MAIN.indexOf(b.name));

const fmt = new Intl.DateTimeFormat(lang === "es" ? "es-AR" : "en-US", { year: "numeric", month: "long" });
const [user, domain] = EMAIL.split("@");

const tile = `${CARD} ${CARD_HOVER} ${FOCUS} group flex flex-col gap-4`;
---

<Layout lang={lang} path="/">
  <main id="main" class="mx-auto w-full max-w-6xl px-4 py-8 sm:px-6 sm:py-12">
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
      <div class={`${CARD} col-span-full sm:p-8 lg:col-span-1 lg:row-span-2`}>
        <Welcome lang={lang} />
      </div>

      <!-- Projects leads with Habita. The whole tile opens /projects like every other tile;
           the "Ver proyectos" link is stretched over it, and the live-site buttons sit above that layer. -->
      <div class={`${CARD} ${CARD_HOVER} group relative col-span-full lg:col-span-2`}>
        <div class="grid items-start gap-5 md:grid-cols-[1fr_1.15fr]">
          <div class="flex h-full flex-col gap-2">
            <h2 class={CARD_TITLE}>{t("nav.projects")}</h2>
            <p class="text-pretty leading-relaxed text-content-secondary">{t("home.projects.blurb")}</p>
            <ul class="relative z-10 mt-2 flex flex-wrap gap-2">
              {
                live.map((p) => (
                  <li>
                    <a href={p.liveUrl} target="_blank" rel="noopener noreferrer" class={`${BUTTON} ${FOCUS}`}>
                      <FaArrowUpRightFromSquare aria-hidden="true" className="size-3.5" />
                      {p.liveUrl!.replace("https://", "")}
                    </a>
                  </li>
                ))
              }
            </ul>
            <a
              href={localizePath("/projects", lang)}
              class={`${FOCUS} mt-auto self-start rounded-sm pt-2 text-sm font-medium text-content-accent after:absolute after:inset-0 after:rounded-2xl after:content-['']`}
            >
              {t("home.projects.cta")}<span aria-hidden="true" class="arrow">&nbsp;→</span>
            </a>
          </div>
          <Image
            src={habita.imageUrl}
            alt={habita.title}
            width={720}
            height={450}
            loading="eager"
            class="aspect-[16/10] w-full rounded-lg object-cover object-left-top outline outline-1 -outline-offset-1 outline-image"
          />
        </div>
      </div>

      <a href={localizePath("/experience", lang)} class={tile}>
        <h2 class={CARD_TITLE}>{t("nav.experience")}</h2>
        <ol class="grid gap-3">
          {
            jobs.map((job) => (
              <li class="flex items-center gap-3">
                <span class="flex size-10 shrink-0 items-center justify-center rounded-lg bg-plate p-1.5">
                  <img src={job.logo} alt="" width="28" height="28" loading="lazy" class="size-7 object-contain" />
                </span>
                <span class="min-w-0">
                  <span class="block font-medium text-content-primary">{job.company}</span>
                  <span class="block text-sm tabular-nums text-content-secondary">{job.period}</span>
                </span>
              </li>
            ))
          }
        </ol>
        <span class="mt-auto text-sm font-medium text-content-accent">
          {t("home.experience.cta")}<span aria-hidden="true" class="arrow">&nbsp;→</span>
        </span>
      </a>

      <a href={localizePath("/tech-stack", lang)} class={tile}>
        <h2 class={CARD_TITLE}>{t("nav.stack")}</h2>
        <ul class="flex flex-wrap gap-2">
          {
            stack.map((tech) => (
              <li class={CHIP}>
                <tech.icon aria-hidden="true" className="size-4 shrink-0" />
                <span class="whitespace-nowrap">{tech.name}</span>
              </li>
            ))
          }
        </ul>
        <span class="mt-auto text-sm font-medium text-content-accent">
          {t("home.stack.cta")}<span aria-hidden="true" class="arrow">&nbsp;→</span>
        </span>
      </a>

      <a href={localizePath("/about", lang)} class={tile}>
        <h2 class={CARD_TITLE}>{t("nav.about")}</h2>
        <p class="text-pretty leading-relaxed text-content-secondary">{t("home.about.blurb")}</p>
        <dl class="grid gap-1 text-sm">
          <div class="flex gap-2"><dt class="font-semibold text-content-primary">{t("about.location")}:</dt><dd class="text-content-secondary">{personalInfo.location}</dd></div>
          <div class="flex gap-2"><dt class="font-semibold text-content-primary">{t("about.languages")}:</dt><dd class="text-content-secondary">{personalInfo.languages}</dd></div>
        </dl>
        <span class="mt-auto text-sm font-medium text-content-accent">
          {t("home.about.cta")}<span aria-hidden="true" class="arrow">&nbsp;→</span>
        </span>
      </a>

      <a href={latest ? localizePath(`/blog/${latest.slug}`, lang) : localizePath("/blog", lang)} class={tile}>
        <h2 class={CARD_TITLE}>{t("nav.blog")}</h2>
        {
          latest ? (
            <div>
              <p class="text-sm text-content-secondary">
                {t("home.blog.latest")} ·{" "}
                <time datetime={latest.data.pubDate.toISOString()}>{fmt.format(latest.data.pubDate)}</time>
              </p>
              <p class="mt-1 text-pretty font-medium leading-snug text-content-primary">{latest.data.title}</p>
            </div>
          ) : (
            <p class="text-pretty leading-relaxed text-content-secondary">{t("home.blog.blurb")}</p>
          )
        }
        <span class="mt-auto text-sm font-medium text-content-accent">
          {t("home.blog.cta")}<span aria-hidden="true" class="arrow">&nbsp;→</span>
        </span>
      </a>

      <!-- Contact: the one filled tile, a mailto like every other tile is a link.
           mailto does nothing without a mail app (webmail users), so the click also copies
           the address and says so: something visible always happens. -->
      <a
        id="contacto"
        href={`mailto:${EMAIL}?subject=${encodeURIComponent(t("contact.subject"))}`}
        data-copy={EMAIL}
        data-done={t("contact.copied")}
        class="focus-ring-light group flex flex-col gap-4 rounded-2xl bg-accent-fill p-5 text-accent-on transition-colors duration-200 hover:bg-accent-fill-hover sm:col-span-2 sm:p-6 lg:col-span-1"
      >
        <h2 class="text-balance text-xl font-semibold">{t("contact.title")}</h2>
        <p class="text-pretty leading-relaxed opacity-90">{t("contact.lead")}</p>
        <p class="break-all text-lg font-semibold">{user}<wbr />@{domain}</p>
        <span class="mt-auto text-sm font-semibold" aria-live="polite">
          <span data-copy-label>{t("contact.cta")}</span><span aria-hidden="true" class="arrow">&nbsp;→</span>
        </span>
      </a>
    </div>
  </main>
</Layout>

<style>
  .arrow {
    display: inline-block;
    transition: transform 150ms ease;
  }
  .group:hover .arrow {
    transform: translateX(4px);
  }
  @media (prefers-reduced-motion: reduce) {
    .arrow { transition: none; }
    .group:hover .arrow { transform: none; }
  }
</style>

<script>
  // Delegated so it survives view-transition body swaps. No preventDefault: the mailto still opens when it can.
  document.addEventListener("click", async (e) => {
    const card = (e.target as Element | null)?.closest<HTMLElement>("[data-copy]");
    if (!card) return;
    const label = card.querySelector<HTMLElement>("[data-copy-label]")!;
    const original = label.textContent;
    try {
      await navigator.clipboard.writeText(card.dataset.copy!);
      label.textContent = card.dataset.done!;
      setTimeout(() => (label.textContent = original), 2500);
    } catch {
      // Clipboard blocked: the address is visible on the card anyway.
    }
  });
</script>
