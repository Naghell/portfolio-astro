---
import Layout from "../../layouts/Layout.astro";
import Welcome from "../../components/Welcome.astro";
import { langPaths } from "../../i18n/paths";
import { toLang, useTranslations, localizePath } from "../../i18n/ui";
import { CARD, CARD_HOVER, FOCUS } from "../../styles/ui";

export const getStaticPaths = langPaths;

const lang = toLang(Astro.params.lang);
const t = useTranslations(lang);

const cards = [
  { path: "/tech-stack", title: t("nav.stack"), blurb: t("home.stack.blurb"), cta: t("home.stack.cta"), span: "sm:col-span-1" },
  { path: "/about", title: t("nav.about"), blurb: t("home.about.blurb"), cta: t("home.about.cta"), span: "sm:col-span-1" },
  { path: "/projects", title: t("nav.projects"), blurb: t("home.projects.blurb"), cta: t("home.projects.cta"), span: "sm:col-span-1 lg:col-span-2" },
  { path: "/experience", title: t("nav.experience"), blurb: t("home.experience.blurb"), cta: t("home.experience.cta"), span: "sm:col-span-1 lg:col-span-2" },
  { path: "/blog", title: t("nav.blog"), blurb: t("home.blog.blurb"), cta: t("home.blog.cta"), span: "col-span-full lg:col-span-1" },
];
---

<Layout lang={lang} path="/">
  <main id="main" class="mx-auto w-full max-w-6xl px-4 py-8 sm:px-6 sm:py-12">
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
      <div class={`${CARD} col-span-full p-6 sm:col-span-1 sm:row-span-2`}>
        <Welcome lang={lang} />
      </div>

      {
        cards.map(({ path, title, blurb, cta, span }) => (
          <a
            href={localizePath(path, lang)}
            class={`${CARD} ${CARD_HOVER} ${FOCUS} group col-span-full flex flex-col justify-between gap-3 p-4 ${span}`}
          >
            <div>
              <h2 class="text-balance text-xl font-semibold text-content-primary">{title}</h2>
              <p class="mt-1 text-pretty leading-relaxed text-content-secondary">{blurb}</p>
            </div>
            <span class="text-sm font-medium text-content-accent">
              {cta}
              <span
                aria-hidden="true"
                class="inline-block transition-transform duration-150 group-hover:translate-x-1 motion-reduce:transition-none motion-reduce:group-hover:translate-x-0"
              >
                &nbsp;→
              </span>
            </span>
          </a>
        ))
      }
    </div>
  </main>
</Layout>
