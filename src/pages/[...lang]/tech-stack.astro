---
import Layout from "../../layouts/Layout.astro";
import PageHeader from "../../components/PageHeader.astro";
import { langPaths } from "../../i18n/paths";
import { toLang, useTranslations } from "../../i18n/ui";
import { techStack } from "../../utils/stack";
import { CARD } from "../../styles/ui";

export const getStaticPaths = langPaths;

const lang = toLang(Astro.params.lang);
const t = useTranslations(lang);
const groups = techStack(lang);
---

<Layout lang={lang} path="/tech-stack">
  <main id="main" class="mx-auto w-full max-w-6xl px-4 py-8 sm:px-6 sm:py-12">
    <PageHeader title={t("nav.stack")} />

    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        groups.map(({ category, items }) => (
          <section class={`${CARD} p-4`}>
            <h2 class="mb-3 text-lg font-semibold text-content-accent">{category}</h2>
            <ul class="space-y-2">
              {items.map((tech) => (
                <li class="flex items-center gap-2 text-content-secondary">
                  <tech.icon aria-hidden="true" className="size-5 shrink-0 text-content-accent" />
                  <span>{tech.name}</span>
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>
  </main>
</Layout>
