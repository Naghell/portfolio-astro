---
import Layout from "../../../layouts/Layout.astro";
import PageHeader from "../../../components/PageHeader.astro";
import { langPaths } from "../../../i18n/paths";
import { toLang, useTranslations, localizePath } from "../../../i18n/ui";
import { postsFor } from "../../../i18n/posts";
import { CARD, CARD_HOVER, CARD_TITLE, CHIP, FOCUS } from "../../../styles/ui";

export const getStaticPaths = langPaths;

const lang = toLang(Astro.params.lang);
const t = useTranslations(lang);
const posts = await postsFor(lang);
const topics = [...new Set(posts.flatMap((p) => p.data.tags))];

const fmt = new Intl.DateTimeFormat(lang === "es" ? "es-AR" : "en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<Layout lang={lang} path="/blog">
  <main id="main" class="mx-auto w-full max-w-6xl px-4 py-8 sm:px-6 sm:py-12">
    <PageHeader title={t("nav.blog")} />

    {
      posts.length === 0 ? (
        <div class={CARD}>
          <p class="font-semibold text-content-primary">{t("blog.empty.title")}</p>
          <p class="mt-1 text-content-secondary">{t("blog.empty.body")}</p>
        </div>
      ) : (
        <ul class="grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-3">
          {posts.map((post, i) => (
            <>
              <li class={i === 0 ? "lg:col-span-2" : ""}>
                <a
                  href={localizePath(`/blog/${post.slug}`, lang)}
                  class={`${CARD} ${CARD_HOVER} ${FOCUS} group flex h-full flex-col gap-3`}
                >
                  <p class="text-sm tabular-nums text-content-secondary">
                    <time datetime={post.data.pubDate.toISOString()}>{fmt.format(post.data.pubDate)}</time>
                  </p>
                  <h2 class={`${CARD_TITLE} ${i === 0 ? "sm:text-2xl" : ""}`}>{post.data.title}</h2>
                  <p class="max-w-[65ch] text-pretty leading-relaxed text-content-secondary">
                    {post.data.description}
                  </p>
                  <span class="mt-auto pt-2 text-sm font-medium text-content-accent">
                    {t("blog.readMore")}
                    <span
                      aria-hidden="true"
                      class="inline-block transition-transform duration-150 group-hover:translate-x-1 motion-reduce:transition-none motion-reduce:group-hover:translate-x-0"
                    >
                      &nbsp;→
                    </span>
                  </span>
                </a>
              </li>
              {/* The side tile sits next to the newest post, so the first row is never a lone stretched card. */}
              {i === 0 && (
                <li class={`${CARD} flex flex-col gap-3`}>
                  <h2 class={CARD_TITLE}>{t("blog.about")}</h2>
                  <p class="text-pretty leading-relaxed text-content-secondary">{t("home.blog.blurb")}</p>
                  <h3 class="mt-2 text-sm font-semibold text-content-primary">{t("blog.topics")}</h3>
                  <ul class="flex flex-wrap gap-2">
                    {topics.map((tag) => (
                      <li class={CHIP}>{tag}</li>
                    ))}
                  </ul>
                </li>
              )}
            </>
          ))}
        </ul>
      )
    }
  </main>
</Layout>
