---
import { getCollection } from "astro:content";
import Layout from "../../../layouts/Layout.astro";
import { DEFAULT_LANG, toLang, useTranslations, localizePath } from "../../../i18n/ui";
import { postPathsByKey } from "../../../i18n/posts";
import { CARD, CHIP, FOCUS } from "../../../styles/ui";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  // A post is emitted only under its own language's route.
  return posts.map((post) => ({
    params: {
      lang: post.data.lang === DEFAULT_LANG ? undefined : post.data.lang,
      slug: post.slug,
    },
    props: { post },
  }));
}

const { post } = Astro.props;
const lang = toLang(Astro.params.lang);
const t = useTranslations(lang);
const { Content } = await post.render();

const altPaths = (await postPathsByKey()).get(post.data.translationKey)!;

const fmt = new Intl.DateTimeFormat(lang === "es" ? "es-AR" : "en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<Layout
  lang={lang}
  path={`/blog/${post.slug}`}
  altPaths={altPaths}
  title={post.data.title}
  description={post.data.description}
  image={post.data.image}
  type="article"
>
  <main id="main" class="mx-auto w-full max-w-6xl px-4 py-8 sm:px-6 sm:py-12">
    <!-- Bento like every other page: the post in a wide tile, its details in a tile beside it. -->
    <div class="grid grid-cols-1 items-start gap-4 lg:grid-cols-3">
      <article class={`${CARD} min-w-0 sm:p-8 lg:col-span-2`}>
        <h1 class="mb-8 text-balance text-3xl font-bold leading-tight tracking-tight text-content-primary sm:text-4xl">
          {post.data.title}
        </h1>
        <div class="post">
          <Content />
        </div>
      </article>

      <aside class={`${CARD} flex flex-col gap-4 lg:sticky lg:top-6`}>
        <dl class="grid gap-3 text-sm">
          <div>
            <dt class="font-semibold text-content-primary">{t("blog.published")}</dt>
            <dd class="tabular-nums text-content-secondary">
              <time datetime={post.data.pubDate.toISOString()}>{fmt.format(post.data.pubDate)}</time>
            </dd>
          </div>
          {
            post.data.updatedDate && (
              <div>
                <dt class="font-semibold text-content-primary">{t("blog.updated")}</dt>
                <dd class="tabular-nums text-content-secondary">
                  <time datetime={post.data.updatedDate.toISOString()}>{fmt.format(post.data.updatedDate)}</time>
                </dd>
              </div>
            )
          }
        </dl>
        {
          post.data.tags.length > 0 && (
            <ul class="flex flex-wrap gap-2">
              {post.data.tags.map((tag) => (
                <li class={CHIP}>{tag}</li>
              ))}
            </ul>
          )
        }
        <a
          href={localizePath("/blog", lang)}
          class={`${FOCUS} inline-flex min-h-11 items-center self-start rounded-sm text-sm font-medium text-content-accent hover:underline hover:underline-offset-4`}
        >
          ← {t("blog.back")}
        </a>
      </aside>
    </div>
  </main>
</Layout>
