---
import { getCollection } from "astro:content";
import Layout from "../../../layouts/Layout.astro";
import { toLang, useTranslations } from "../../../i18n/ui";
import { postPathsByKey } from "../../../i18n/posts";
import { CARD, CHIP } from "../../../styles/ui";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  // A post is emitted only under its own language's route.
  return posts.map((post) => ({
    params: {
      lang: post.data.lang === "en" ? undefined : post.data.lang,
      slug: post.slug,
    },
    props: { post },
  }));
}

const { post } = Astro.props;
const lang = toLang(Astro.params.lang);
const t = useTranslations(lang);
const { Content } = await post.render();

const altPaths = (await postPathsByKey()).get(post.data.translationKey)!;

const fmt = new Intl.DateTimeFormat(lang === "es" ? "es-AR" : "en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<Layout
  lang={lang}
  path={`/blog/${post.slug}`}
  altPaths={altPaths}
  title={post.data.title}
  description={post.data.description}
  image={post.data.image}
  type="article"
>
  <main id="main" class="mx-auto w-full max-w-6xl px-4 py-8 sm:px-6 sm:py-12">
    <article class={`${CARD} w-full max-w-3xl p-5 sm:p-8`}>
      <header class="mb-6">
        <h1 class="text-balance text-3xl font-bold tracking-tight text-content-primary sm:text-4xl">
          {post.data.title}
        </h1>
        <p class="mt-2 text-sm tabular-nums text-content-secondary">
          {t("blog.published")}
          <time datetime={post.data.pubDate.toISOString()}>{fmt.format(post.data.pubDate)}</time>
          {
            post.data.updatedDate && (
              <>
                {" · "}
                {t("blog.updated")}
                <time datetime={post.data.updatedDate.toISOString()}>
                  {fmt.format(post.data.updatedDate)}
                </time>
              </>
            )
          }
        </p>
        {
          post.data.tags.length > 0 && (
            <ul class="mt-3 flex flex-wrap gap-2">
              {post.data.tags.map((tag) => (
                <li class={CHIP}>{tag}</li>
              ))}
            </ul>
          )
        }
      </header>

      <div class="post">
        <Content />
      </div>
    </article>
  </main>
</Layout>
