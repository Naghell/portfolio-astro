---
import { Image } from "astro:assets";
import { FaGithub, FaArrowUpRightFromSquare } from "react-icons/fa6";
import Layout from "../../layouts/Layout.astro";
import PageHeader from "../../components/PageHeader.astro";
import { langPaths } from "../../i18n/paths";
import { toLang, useTranslations } from "../../i18n/ui";
import { projects } from "../../utils/projects";
import { CARD, CARD_TITLE, CHIP, BUTTON, FOCUS } from "../../styles/ui";

export const getStaticPaths = langPaths;

const lang = toLang(Astro.params.lang);
const t = useTranslations(lang);
const items = projects(lang);
---

<Layout lang={lang} path="/projects">
  <main id="main" class="mx-auto w-full max-w-6xl px-4 py-8 sm:px-6 sm:py-12">
    <PageHeader title={t("nav.projects")} />

    <ul class="grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-3">
      {
        items.map((project, i) => (
          <li
            class={`${CARD} flex flex-col gap-4 ${
              project.size === "full"
                ? "md:col-span-2 lg:col-span-3 lg:grid lg:grid-cols-[1.25fr_1fr] lg:gap-6"
                : project.size === "wide"
                  ? "md:col-span-2 lg:grid lg:grid-cols-[1fr_1.1fr] lg:gap-5"
                  : ""
            }`}
          >
            <Image
              src={project.imageUrl}
              alt=""
              width={project.size ? 900 : 500}
              height={project.size ? 560 : 300}
              loading={i === 0 ? "eager" : "lazy"}
              class={`${project.size === "wide" ? "aspect-[16/10] object-left-top lg:aspect-auto lg:h-full" : project.size ? "aspect-[16/10] object-left-top" : "h-44"} w-full rounded-lg object-cover outline outline-1 -outline-offset-1 outline-image`}
            />
            <div class="flex flex-1 flex-col gap-3">
            <h2 class={CARD_TITLE}>{project.title}</h2>
            <p class="flex-1 text-pretty leading-relaxed text-content-secondary">
              {project.description}
            </p>

            <ul class="flex flex-wrap gap-2">
              {project.technologies.map((tech) => (
                <li class={CHIP}>
                  <tech.icon aria-hidden="true" className="size-4 shrink-0" />
                  <span class="whitespace-nowrap">{tech.name}</span>
                </li>
              ))}
            </ul>

            {(project.githubUrl || project.liveUrl) && (
              <div class="flex flex-wrap gap-2">
                {project.githubUrl && (
                  <a
                    href={project.githubUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={t("projects.githubOf", { project: project.title })}
                    class={`${BUTTON} ${FOCUS}`}
                  >
                    <FaGithub aria-hidden="true" />
                    {t("projects.github")}
                  </a>
                )}
                {project.liveUrl && (
                  <a
                    href={project.liveUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={t("projects.liveOf", { project: project.title })}
                    class={`${BUTTON} ${FOCUS}`}
                  >
                    <FaArrowUpRightFromSquare aria-hidden="true" className="size-3.5" />
                    {t("projects.live")}
                  </a>
                )}
              </div>
            )}
            </div>
          </li>
        ))
      }
    </ul>
  </main>
</Layout>
